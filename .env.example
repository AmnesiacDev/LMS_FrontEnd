# ─── AlgoGambit Frontend — Environment Variables ───────────────────────────
# Copy this file to .env.local for local development.
# Never commit .env.local or any file containing real secrets.

# Base URL of the backend API.
# In local development this can stay empty so Vite proxies /api to localhost:3000.
# In production set it to your deployed API origin, e.g. https://api.algogambit.com
VITE_API_BASE=

# Socket.IO backend origin. Leave empty to reuse VITE_API_BASE, or localhost:3000 in dev.
VITE_SOCKET_URL=

# Legacy alias still supported by the app for older local .env files.
VITE_API_BASE_URL=

# Optional: endpoint that receives batched frontend error reports.
# Leave empty to disable remote error reporting.
# Example: https://api.algogambit.com/api/v1/errors
VITE_ERROR_ENDPOINT=
