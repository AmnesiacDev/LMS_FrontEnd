
@Library('leroy-jenkins-library') _

pipeline {
    agent any

    options {
        timestamps()
        disableConcurrentBuilds()
        buildDiscarder(logRotator(numToKeepStr: '20'))
    }
    parameters {
        string(
            name: 'IMAGE_TAG',
            defaultValue: '',
            description: 'Docker image tag supplied by orchestrator'
        )
    }

    environment {
        SERVICE_NAME     = 'frontend'
        IMAGE_NAME       = 'lms-frontend'
        INFRA_DIR        = '/opt/LMS_Infra'
    }

    stages {

        stage('Checkout Frontend') {
            agent {label 'node-agent'}
            steps {
                dir('LMS_FrontEnd') {
                    checkout scm
                }
            }
        }

        stage('Frontend Env File') {
            agent { label 'node-agent' }
        
            steps {
                withCredentials([
                    file(credentialsId: 'frontend-env', variable: 'ENV_FILE')
                ]) {
                    dir('LMS_FrontEnd') {
                        sh 'cp "$ENV_FILE" .env.production'
                    }
                }
            }
        }

        stage('Build Image') {
            agent {label 'node-agent'}
            steps {
                dir('LMS_FrontEnd') {
                    script{
                        dockerBuild("${IMAGE_NAME}", "${IMAGE_TAG}") 
                    }
                }
            }
        }

        stage('Test') {
            agent {label 'node-agent'}
            steps {
                script {
                    imageTestNode("${IMAGE_NAME}:${IMAGE_TAG}")
                }
            }
        }

        stage('Compose Build') {
            agent {label 'node-agent'}
            steps {
                dir("${INFRA_DIR}") {
                    script {
                        composeBuild("${SERVICE_NAME}")
                    }
                }
            }
        }
    }

    post {
        failure {
            echo "Frontend pipeline failed at stage: ${env.STAGE_NAME}. Check frontend-debug.log artifact if present."
        }
        always {
            sh 'docker image prune -f || true'
        }
    }
}
