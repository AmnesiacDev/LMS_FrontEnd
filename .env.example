# ─── AlgoGambit Frontend — Environment Variables ───────────────────────────
# Copy this file to .env.local for local development.
# Never commit .env.local or any file containing real secrets.

# Base URL of the backend API (used by the Vite dev proxy and production builds).
# In development this is handled by the Vite proxy, so you can leave it empty.
# In production set it to your deployed API origin, e.g. https://api.algogambit.com
VITE_API_BASE_URL=

# Optional: endpoint that receives batched frontend error reports.
# Leave empty to disable remote error reporting.
# Example: https://api.algogambit.com/api/v1/errors
VITE_ERROR_ENDPOINT=
