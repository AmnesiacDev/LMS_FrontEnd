# ─── AlgoGambit Frontend — Environment Variables ───────────────────────────
# Copy this file to .env.local for local development.
# Never commit .env.local or any file containing real secrets.

# Public origin of the backend API (never include a path or trailing slash).
# Local development: may stay empty so Vite proxies /api to localhost:3000.
# Production/Preview: required and must be a non-local HTTPS origin.
# Example: https://api.algogambit.com
VITE_API_BASE=

# Public Socket.IO backend origin (never include a path or trailing slash).
# Local development: may stay empty to reuse VITE_API_BASE, then localhost:3000.
# Production/Preview: required and must be a non-local HTTPS origin.
# Example: https://api.algogambit.com
VITE_SOCKET_URL=

# Deprecated local-development alias. Production builds require VITE_API_BASE.
VITE_API_BASE_URL=

# Optional: endpoint that receives batched frontend error reports.
# Leave empty to disable remote error reporting.
# When set for Production/Preview, it must be a non-local HTTPS URL.
# Example: https://api.algogambit.com/api/v1/errors
VITE_ERROR_ENDPOINT=
